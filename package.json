{
  "name": "pi-subagents",
  "version": "0.58.0",
  "description": "Delegate tasks to specialized AI agents with isolated context windows",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "multi-agent",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "Nico Bailon",
  "homepage": "https://github.com/nicobailon/pi-subagents",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicobailon/pi-subagents.git"
  },
  "type": "module",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "skills/**/*",
    "benchmarks/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --import tsx --test src/tests/*.test.ts src/extension/*.test.ts"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "latest",
    "@mariozechner/pi-coding-agent": "latest",
    "@mariozechner/pi-tui": "latest",
    "@sinclair/typebox": "^0.34.41",
    "strip-ansi": "^7.1.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.53.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
